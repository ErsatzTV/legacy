            </div>
            <MudDivider Class="mb-6"/>

            <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-10">
                @foreach (ArtistCardViewModel card in _artists.Cards.OrderBy(s => s.SortTitle))
