@page "/system/troubleshooting"
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.Json.Serialization
@using ErsatzTV.Application.Streaming
@using ErsatzTV.Application.Troubleshooting
@using ErsatzTV.Application.Troubleshooting.Queries
@using ErsatzTV.Core.Interfaces.Streaming
@using ErsatzTV.Core.Next.Description
@implements IDisposable
@inject IMediator Mediator
@inject IJSRuntime JsRuntime

<MudForm Style="max-height: 100%">
    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
            <MudText Typo="Typo.h5" Class="mb-2">Troubleshooting</MudText>
            <MudDivider Class="mb-6"/>
            <MudTabs Class="mb-6" @bind-ActivePanelIndex="_activeTab">
                <MudTabPanel Text="Tools">
                    <MudPaper Class="pa-6" Style="max-height: 500px">
                        <MudStack>
                        <!--
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Troubleshoot"
                                       Href="system/troubleshooting/playback"
                                       Style="margin-right: auto"
                                       Disabled="true"
                                       Class="mt-6">
                                Playback Troubleshooting
                            </MudButton>
                            -->
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Checklist"
                                       Href="system/troubleshooting/sequential-schedule"
                                       Class="mt-6"
                                       Style="margin-right: auto">
                                Sequential Schedule Validation
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Troubleshoot"
                                       Href="system/troubleshooting/block-playout"
                                       Class="mt-6"
                                       Style="margin-right: auto">
                                Block Playout Troubleshooting
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudTabPanel>
                <MudTabPanel Text="General">
                    <MudPaper Class="pa-6">
                        <div class="overflow-y-scroll" style="max-height: 500px">
                            <JsonView @ref="_troubleshootingView" Json="@_troubleshootingInfo" Class="wrap-pre"/>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="@(() => CopyToClipboard(_troubleshootingView.CodeElement))">
                            Copy
                        </MudButton>
                    </MudPaper>
                </MudTabPanel>
                <MudTabPanel Text="Hardware">
                    <MudPaper Class="pa-6">
                        <div class="d-flex flex-row align-center mb-4">
                            @if (_nextProbe is null)
                            {
                                <MudText>No hardware probe has finished yet.</MudText>
                            }
                            else
                            {
                                <MudText>
                                    Probed @_nextProbe.ProbedAt.ToLocalTime().ToString("G") with ffmpeg @(_nextProbe.Capability.Ffmpeg.Version ?? "(unknown version)") at @_nextProbe.Capability.Ffmpeg.Path
                                </MudText>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                           Size="Size.Small"
                                           Class="ml-2"
                                           title="Probe hardware again"
                                           Disabled="@_probing"
                                           OnClick="@Reprobe"/>
                            @if (_probing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2"/>
                            }
                        </div>
                        @if (_nextProbe is not null)
                        {
                            <MudText Typo="Typo.body2" Class="mb-4">
                                ffmpeg hwaccels: @string.Join(", ", _nextProbe.Capability.Ffmpeg.Hwaccels)
                            </MudText>
                            <MudTable Items="@_nextProbe.Capability.Accels" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                                <HeaderContent>
                                    <MudTh>Acceleration</MudTh>
                                    <MudTh>Device</MudTh>
                                    <MudTh>Driver</MudTh>
                                    <MudTh>Decode</MudTh>
                                    <MudTh>Encode</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <div style="align-items: center; display: flex; flex-direction: row;">
                                            @if (context.Status == AccelStatus.Available)
                                            {
                                                <MudIcon Color="@Color.Success" Icon="@Icons.Material.Filled.Check"/>
                                            }
                                            else
                                            {
                                                <MudIcon Color="@Color.Error" Icon="@Icons.Material.Filled.Error"/>
                                            }
                                            <div class="ml-2">@context.Accel</div>
                                        </div>
                                    </MudTd>
                                    <MudTd>@(context.Device ?? "")</MudTd>
                                    <MudTd>@(context.Accel == "vaapi" ? context.Driver ?? "(libva default)" : "")</MudTd>
                                    @if (context.Status == AccelStatus.Available)
                                    {
                                        <MudTd>@DecodeText(context)</MudTd>
                                        <MudTd>@EncodeText(context)</MudTd>
                                    }
                                    else
                                    {
                                        <MudTd colspan="2">@StatusText(context)</MudTd>
                                    }
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        </MudContainer>
    </div>
</MudForm>

@code {
    private CancellationTokenSource _cts;
    private string _troubleshootingInfo;
    private const int HardwareTab = 2;

    [SupplyParameterFromQuery(Name = "tab")]
    public string Tab { get; set; }

    private int _activeTab;
    private NextProbeResult _nextProbe;
    private bool _probing;
    private JsonView _troubleshootingView;

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        _activeTab = string.Equals(Tab, "hardware", StringComparison.OrdinalIgnoreCase) ? HardwareTab : 0;

        try
        {
            TroubleshootingInfo info = await Mediator.Send(new GetTroubleshootingInfo(NextVersion.Version), token);

            _troubleshootingInfo = JsonSerializer.Serialize(
                new
                {
                    LegacyVersion = info.Version,
                    info.NextVersion,
                    info.NextDescribe,
                    NextProbe = info.NextProbe is null
                        ? null
                        : new { info.NextProbe.ProbedAt, info.NextProbe.Capability },
                    info.FFmpegVersion,
                    Environment = info.Environment.OrderBy(x => x.Key).ToDictionary(x => x.Key, x => x.Value),
                    info.Cpus,
                    info.VideoControllers,
                    info.Health,
                    info.FFmpegSettings,
                    AviSynth = new
                    {
                        Demuxer = info.AviSynthDemuxer,
                        Installed = info.AviSynthInstalled
                    },
                    info.Channels,
                    info.FFmpegProfiles
                },
                new JsonSerializerOptions
                {
                    Converters = { new JsonStringEnumConverter() },
                    DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
                    // Blazor HTML-encodes output, so JSON escaping only hurts readability
                    Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                    WriteIndented = true
                });

            _nextProbe = info.NextProbe;
        }
        catch (OperationCanceledException)
        {
            // do nothing
        }
        catch (Exception ex)
        {
            _troubleshootingInfo = ex.ToString();
        }
    }

    private async Task CopyToClipboard(ElementReference view) => await JsRuntime.InvokeVoidAsync("clipboardCopy.copyText", view);

    private async Task Reprobe()
    {
        _probing = true;
        try
        {
            Option<NextProbeResult> result = await Mediator.Send(new RefreshNextProbe(), _cts.Token);
            _nextProbe = result.MatchUnsafe(identity, () => null);
        }
        catch (OperationCanceledException)
        {
            // do nothing
        }
        finally
        {
            _probing = false;
        }
    }

    private static string DecodeText(AccelRuntime accel) =>
        accel.Decode.Count == 0
            ? "none"
            : string.Join(", ", accel.Decode.Map(d => $"{d.Format} ({string.Join(", ", d.PixelFormats)})"));

    private static string EncodeText(AccelRuntime accel) =>
        accel.Encode.Count == 0
            ? "none"
            : string.Join(", ", accel.Encode.Map(e => $"{e.Format} ({string.Join("/", e.BitDepths)}-bit)"));

    private static string StatusText(AccelRuntime accel) =>
        accel.Status switch
        {
            AccelStatus.FfmpegMissing => accel.Error ?? "ffmpeg doesn't support this acceleration",
            AccelStatus.Timeout => accel.Error ?? "probe timed out",
            AccelStatus.Skipped => "not probed, because an earlier probe of this acceleration timed out",
            _ => accel.Error ?? "probe failed"
        };

}
